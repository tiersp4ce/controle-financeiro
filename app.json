{
  "expo": {
    "name": "Controle Financeiro",
    "slug": "mobile-app-financeiro",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "finapp",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      "expo-sqlite"
    ]
  }
}
